{
  "name": "quiet-feed",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that filters X timelines with the user's own TypeSafe Jev API key.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "build:nodeps": "node scripts/build-nodeps.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test \"test/integration/**/*.test.ts\"",
    "test:mutation": "node scripts/mutation.mjs --min 80",
    "test:browser": "node scripts/build-nodeps.mjs && node scripts/test-server.mjs",
    "test:local-server": "cd local-server && .venv/bin/python -m unittest discover -s tests -t ."
  },
  "devDependencies": {
    "@types/chrome": "0.2.9",
    "@types/node": "24.13.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
